---
import FolderTabs from './FolderTabs';
import { ImageCarousel, type CarouselImage } from '../ui/image-carousel';

interface Props {
  id: string;
  title: string;
  excerpt: string;
  problem?: string;
  task?: string;
  outcome?: string;
  facts: { label: string; value: string }[];
  accent: string;
  slug: string;
  images: CarouselImage[];
}

const { id, title, excerpt, problem, task, outcome, facts, accent, slug, images } = Astro.props;
---

<section id={id} data-project-section class="scroll-mt-28">
  <div class="flex flex-col gap-6 md:flex-row md:items-stretch">
    <div class="min-h-[360px] flex-1 overflow-hidden rounded-[28px]">
      <ImageCarousel client:visible images={images} />
    </div>

    <div class="flex flex-1 flex-col overflow-hidden rounded-[28px] bg-black/35 shadow-[0_20px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl">
      <div class="border-b border-white/10 px-6 pb-6 pt-8 sm:px-8">
        <h2 class="font-display text-2xl text-white sm:text-[32px]">{title}</h2>
        <p class="mt-2 text-white/70">{excerpt}</p>
      </div>

      <div class="px-2 py-4 sm:px-4">
        <FolderTabs
          client:visible
          id={id}
          problem={problem}
          approach={task}
          facts={facts}
          outcome={outcome}
          excerpt={excerpt}
          accent={accent}
          slug={slug}
        />
      </div>
    </div>
  </div>
</section>

---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/90 backdrop-blur">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-lg font-medium tracking-tight text-ink">
      tori bryan
    </a>
    <ul class="flex items-center gap-6 text-sm text-ink-secondary">
      {
        links.map((link) => {
          const isActive =
            link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'transition-colors hover:text-ink',
                  isActive && 'font-medium text-ink',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

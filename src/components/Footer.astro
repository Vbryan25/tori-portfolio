---
const year = new Date().getUTCFullYear();
const links = [
  { href: 'mailto:hello@toribryan.design', label: 'Email' },
  { href: 'https://linkedin.com/in/toribryan', label: 'LinkedIn', external: true },
  { href: '/resume.pdf', label: 'Resume' },
];
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-ink-tertiary">© {year} Tori Bryan</p>
    <ul class="flex items-center gap-6 text-sm text-ink-secondary">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-ink"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

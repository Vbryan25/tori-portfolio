---
import { Image } from 'astro:assets';
import bonzo1 from '../assets/bonzo/bonzo-1.jpg';
import bonzo2 from '../assets/bonzo/bonzo-2.jpg';
import bonzo3 from '../assets/bonzo/bonzo-3.jpg';
import bonzo4 from '../assets/bonzo/bonzo-4.jpg';

const photos = [bonzo4, bonzo1, bonzo2, bonzo3];
---

<button
  type="button"
  data-bonzo-open
  class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-ink-secondary transition-colors hover:border-ink/30 hover:text-ink"
>
  <Image src={bonzo4} alt="Bonzo the pug" width={48} height={48} class="h-6 w-6 rounded-full object-cover" />
  bonzo
</button>

<dialog
  data-bonzo-dialog
  class="m-auto w-full max-w-lg rounded-2xl border border-border bg-surface p-6 backdrop:bg-ink/40"
>
  <div class="flex items-center justify-between">
    <h2 class="font-display text-lg text-ink">bonzo</h2>
    <button type="button" data-bonzo-close class="text-ink-tertiary hover:text-ink" aria-label="Close">
      ✕
    </button>
  </div>
  <div class="mt-4 grid grid-cols-2 gap-2">
    {
      photos.map((photo) => (
        <Image src={photo} alt="Bonzo the pug" width={300} height={300} class="aspect-square w-full rounded-lg object-cover" />
      ))
    }
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-bonzo-open]').forEach((btn) => {
    const dialog = btn.parentElement?.querySelector<HTMLDialogElement>('[data-bonzo-dialog]');
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-bonzo-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  });
</script>
